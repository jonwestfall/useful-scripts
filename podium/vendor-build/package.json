{
  "name": "podium-vendor-build",
  "private": true,
  "description": "Rebuilds the vendored browser bundles: Marp, CodeMirror for the deck editor, and Mermaid for diagrams in decks",
  "scripts": {
    "build": "node build-marp.mjs && node build-codemirror.mjs && node build-mermaid.mjs",
    "build:marp": "node build-marp.mjs",
    "build:codemirror": "node build-codemirror.mjs",
    "build:mermaid": "node build-mermaid.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@marp-team/marp-core": "4.4.0",
    "esbuild": "^0.25.0",
    "mermaid": "12.1.0"
  }
}
