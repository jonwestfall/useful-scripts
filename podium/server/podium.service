# /etc/systemd/system/podium.service
#   sudo systemctl enable --now podium
[Unit]
Description=Podium relay
After=network.target

[Service]
Type=simple
User=podium
WorkingDirectory=/opt/podium/server
Environment=PORT=8080
# Serve the pages from the same box as well:
#Environment=STATIC=../
# Lock the relay to your own site:
#Environment=ORIGIN=https://jonwestfall.github.io
# Put the pages behind a login (join.html stays open) - see README's Security section:
#Environment=AUTH_PASSWORD=something-long-and-random
#Environment=AUTH_USER=podium
# Give it somewhere to remember things and it gains accounts, which supersede
# AUTH_PASSWORD above. See VPS.md; deploy/install.sh sets all of this up for
# you, and this file is the hand-rolled alternative.
#Environment=DATA_DIR=/var/lib/podium
#ReadWritePaths=/var/lib/podium
ExecStart=/usr/bin/node podium-server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
